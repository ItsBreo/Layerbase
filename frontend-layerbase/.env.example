# --- Origen del backend ---
# Vacío en local: `vite.config.ts` proxya /api a http://localhost:8000 y así no
# hay CORS de por medio.
#
# Desplegado es OBLIGATORIA. Lleva el origen del backend SIN /api (el sufijo lo
# añade `src/lib/api.ts`), sin barra final:
#   VITE_API_URL=https://layerbase-api-xxxxx.europe-southwest1.run.app
#
# Es de BUILD, no de ejecución: Vite la incrusta al compilar. Cambiarla obliga a
# reconstruir el frontend, y el dominio resultante tiene que estar en el
# CORS_ALLOWED_ORIGINS del backend.
VITE_API_URL=

# Solo para Docker: apunta el proxy de Vite al nginx interno en vez de a
# localhost. Fuera de Docker se deja vacío.
VITE_PROXY_TARGET=

# --- Proveedores de inicio de sesión social ---
# Lista separada por comas. Vacío = se muestran todos (lo normal en local).
#
# En producción va solo `github`: publicar la app de Google exige demostrar la
# propiedad del dominio, y el de CloudFront es de Amazon. Vuelve a habilitarse
# quitando esta variable cuando haya dominio propio.
VITE_OAUTH_PROVIDERS=
