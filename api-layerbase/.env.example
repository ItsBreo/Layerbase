APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL no es intercambiable aquí: el buscador usa su búsqueda de texto
# completo (`to_tsvector`, `websearch_to_tsquery`, `pg_trgm`). La suite de tests
# corre contra la base `layerbase_testing`, en el mismo servidor.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=layerbase
DB_USERNAME=layerbase
DB_PASSWORD=LayerBase

# Cuánto tiene que parecerse algo para que la búsqueda difusa lo dé por bueno
# cuando la búsqueda exacta no ha encontrado nada (0 = todo vale, 1 = idéntico).
# Ver config/components.php.
COMPONENTS_SEARCH_FUZZY_THRESHOLD=0.4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo -------------------------------------------------------------
# En LOCAL sale por Mailpit (docker compose): nada llega a internet y los
# correos se leen en http://localhost:8025
#
# En PRODUCCIÓN se cambian estas variables por las del proveedor. Con Resend
# por SMTP sería algo así (SIN tocar una línea de código):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=<api-key>
#
# El remitente ya apunta al dominio compartido de Resend para no depender de
# tener dominio propio todavía. OJO: ese dominio de pruebas suele venir con
# límites (típicamente solo permite escribir a la dirección de tu cuenta) —
# confírmalo al crear la cuenta. Con dominio propio hay que configurar
# además SPF y DKIM en el DNS, o los correos acaban en spam.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# --- Almacenamiento de objetos (Amazon S3) ---
# En local todo va a disco y esto se queda vacío. Desplegado hace falta: el
# contenedor tiene disco EFÍMERO y lo subido desaparece al reciclar o escalar.
#
# Son DOS buckets, no uno con dos carpetas:
#   - el privado guarda los archivos de componente, que se sirven solo por URL
#     firmada temporal (el `source` de un componente de pago ES el producto);
#   - el público guarda los avatares, que necesitan URL permanente.
# Compartir bucket haría que el dominio público sirviera también el código
# fuente, saltándose la policy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Región real (p. ej. eu-west-1). No dejar vacío desplegado.
AWS_DEFAULT_REGION=
# Bucket PRIVADO. Con "Block all public access" activado.
AWS_BUCKET=
# Bucket PÚBLICO (avatares) y la URL desde la que se sirven, sin barra final:
# el dominio del bucket o el de una distribución de CloudFront por delante.
AWS_PUBLIC_BUCKET=
AWS_PUBLIC_URL=
# Credenciales propias del bucket público. Vacías = reutiliza las de arriba.
AWS_PUBLIC_ACCESS_KEY_ID=
AWS_PUBLIC_SECRET_ACCESS_KEY=
# Solo para almacenamiento compatible con S3 que NO sea AWS (Cloudflare R2,
# MinIO). En AWS se deja vacío y el SDK resuelve su propio endpoint.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Discos que usa cada módulo ---
# Desplegado: COMPONENTS_FILES_DISK=s3 y PROFILE_AVATAR_DISK=s3_public.
COMPONENTS_FILES_DISK=local
PROFILE_AVATAR_DISK=public

# URL del SPA (React/Vite). Usada para callback de OAuth y enlace de reseteo.
FRONTEND_URL=http://localhost:5173

# --- Autenticación API (Sanctum) ---
# Minutos de vida del token (vacío = sin expiración). Recomendado fijarlo en prod.
SANCTUM_TOKEN_EXPIRATION=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
# Prefijo opcional para que los escáneres de secretos detecten tokens filtrados.
SANCTUM_TOKEN_PREFIX=

# CORS — orígenes permitidos en producción (coma-separados). En local basta FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# --- OAuth (Socialite) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/api/auth/github/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# --- Seeder de admin inicial (opcional; vacío = no se crea) ---
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
